{
  "name": "oneed-institute",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "@testing-library/dom": "^10.4.1",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.35.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/generate-prerendered-pages.js",
    "test": "vitest run --config vitest.config.mjs",
    "prebuild": "node scripts/diagnose-cloudflare-env.cjs && node scripts/validate-build-env.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:watch": "vitest --config vitest.config.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "jsdom": "^29.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
